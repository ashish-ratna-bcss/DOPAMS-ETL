# CCTNS V1 API (source)
FIR_API_URL=<dopams-new-fir-api-url>
COURT_API_URL=<dopams-new-court-api-url>
ACCUSED_DETAILS_API_URL=<dopams-new-accused-details-api-url>
ACCUSED_API_URL=<dopams-new-accused-api-url>

# Postgres — one database, two schemas (do not merge into public)
PG_HOST=<dopams-new-ip>
PG_PORT=5432
PG_DATABASE=cctns_v1
PG_USER=<dopams-new-username>
PG_PASSWORD=<dopams-new-password>
PG_ETL_SCHEMA=<dopams-new-etl-schema>
PG_AIRFLOW_SCHEMA=<dopams-new-airflow-schema>

# Accused date-range full pull start (DD-MM-YYYY)
ACCUSED_FULL_PULL_START_DATE=01-01-2002

# Airflow UI (required for PM2 start — never use password "admin")
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<set-a-strong-password-min-12-chars>
AIRFLOW_ADMIN_EMAIL=admin@localhost
# Prefer a private NIC IP instead of 0.0.0.0 when possible
AIRFLOW_WEBSERVER_HOST=192.168.103.106
# Fixed: UI must be 9001 only (wrapper refuses any other port)
AIRFLOW_WEBSERVER_PORT=9001
# HTTPS for UI (default on). Self-signed cert auto-created under deploy/tls/.
AIRFLOW_TLS_ENABLE=1
# Optional override paths:
# AIRFLOW_TLS_CERT=/path/to/airflow.crt
# AIRFLOW_TLS_KEY=/path/to/airflow.key

# Postgres client TLS mode (prefer = use SSL if server offers it; require = fail if no SSL)
PG_SSLMODE=prefer

# Fail-closed: any child row whose FIR is missing from cctns_fir fails the task (0 = strict)
CCTNS_ORPHAN_FIR_MAX=0

# Optional: Slack/Teams/generic webhook for Airflow task failures (JSON POST).
# Leave empty to rely on logs/etl_failures.log + Airflow UI only.
# CCTNS_ALERT_WEBHOOK_URL=https://hooks.example.com/services/...
