# CCTNS V1 API (source)
FIR_API_URL=<dopams-new-fir-api-url>
COURT_API_URL=<dopams-new-court-api-url>
ACCUSED_DETAILS_API_URL=<dopams-new-accused-details-api-url>
ACCUSED_API_URL=<dopams-new-accused-api-url>

# Postgres — one database, two schemas (do not merge into public)
PG_HOST=<dopams-new-ip>
PG_PORT=5432
PG_DATABASE=cctns_v1
PG_USER=<dopams-new-username>
PG_PASSWORD=<dopams-new-password>
PG_ETL_SCHEMA=<dopams-new-etl-schema>
PG_AIRFLOW_SCHEMA=<dopams-new-airflow-schema>

# Accused date-range full pull start (DD-MM-YYYY)
ACCUSED_FULL_PULL_START_DATE=01-01-2002

# Airflow UI (required for PM2 start — never use password "admin")
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<set-a-strong-password-min-12-chars>
AIRFLOW_ADMIN_EMAIL=admin@localhost
# Prefer a private NIC IP instead of 0.0.0.0 when possible
AIRFLOW_WEBSERVER_HOST=0.0.0.0
AIRFLOW_WEBSERVER_PORT=9001
