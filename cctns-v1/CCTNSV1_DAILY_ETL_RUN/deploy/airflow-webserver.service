[Unit]
Description=Airflow webserver (CCTNS V1) — port 9001 only; prefer PM2
After=network.target postgresql.service

[Service]
User=tganb
WorkingDirectory=/home/tganb/dopams/DOPAMS-ETL/cctns-v1/CCTNSV1_DAILY_ETL_RUN
# Host/port from .env via wrapper (must be 9001).
ExecStart=/home/tganb/dopams/DOPAMS-ETL/cctns-v1/CCTNSV1_DAILY_ETL_RUN/deploy/airflow_with_env.sh webserver
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
