[Unit]
Description=Airflow scheduler (CCTNS V1) — prefer PM2
After=network.target postgresql.service

[Service]
User=tganb
WorkingDirectory=/home/tganb/dopams/DOPAMS-ETL/cctns-v1/CCTNSV1_DAILY_ETL_RUN
ExecStart=/home/tganb/dopams/DOPAMS-ETL/cctns-v1/CCTNSV1_DAILY_ETL_RUN/deploy/airflow_with_env.sh scheduler
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
