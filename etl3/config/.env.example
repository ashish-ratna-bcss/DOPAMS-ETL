# ETL-3 unified database (destination -- read/write)
# Allowed values: dopams_cctns (baseline) or dopams_cctns_v2 (enhanced parallel build)
UNIFIED_PG_HOST=
UNIFIED_PG_PORT=5432
UNIFIED_PG_DATABASE=dopams_cctns_v2
UNIFIED_PG_USER=
UNIFIED_PG_PASSWORD=
UNIFIED_PG_SCHEMA=public

# Source databases (read-only) -- paths to the existing V1/V2 ETL .env files.
# ETL-3 reuses their connection details but ALWAYS forces a read-only Postgres
# session (see db/connections.py) regardless of what the underlying role can
# do -- it never trusts the source .env's own privilege level.
V1_SOURCE_ENV_PATH=../cctns-v1/CCTNSV1_DAILY_ETL_RUN/.env
V2_SOURCE_ENV_PATH=../cctns-v2/.env

# Ollama (enhancement). Required when ETL3_AI_ENABLED=1.
# Set the base URL and model in the environment / local .env only.
# Code has no hardcoded endpoint or model fallback.
# Legacy aliases also accepted: OLLAMA_HOST, LLM_MODEL_EXTRACTION
OLLAMA_BASE_URL=
OLLAMA_MODEL=
ETL3_AI_ENABLED=0
# limited = honour ETL3_AI_LIMIT (tests/diagnostics)
# backfill = process full eligible backlog in ETL3_AI_BATCH_SIZE batches
ETL3_AI_MODE=backfill
ETL3_AI_LIMIT=0
# Small commit batches + inter-request delay for 8 GB GPU Ollama hosts.
ETL3_AI_BATCH_SIZE=5
ETL3_AI_MAX_RETRIES=2
ETL3_AI_REQUEST_DELAY_SEC=3
ETL3_AI_HEALTH_COOLDOWN_SEC=60
# Qwen3: leave thinking off for JSON extraction (see OLLAMA_THINK).
OLLAMA_THINK=0
LLM_TIMEOUT=180

# Media roots used when classifying availability on this host.
# Prefer values already set in V1/V2 source .env files; these are optional overrides.
# MEDIA_BASE_DIR=/home/eagle/media_cctnsv1
# FILES_MEDIA_BASE_PATH=/mnt/shared-etl-files
